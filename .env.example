# ==============================================================================
# Dently SaaS Platform - Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.production and fill in your real credentials.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Production: Use your managed PostgreSQL service connection string with SSL if required.
DATABASE_URL="postgresql://dently:your_secure_password@localhost:5433/dently?schema=public"

# Connection Pool Size (default: 20)
DB_POOL_SIZE=20

# Docker Compose PostgreSQL host port (default: 5433 to avoid conflicts with local 5432)
POSTGRES_PORT=5433

# ------------------------------------------------------------------------------
# 2. Redis & Background Workers
# ------------------------------------------------------------------------------
# Connection string format: redis://[:password@]host:port[/db]
# Used by BullMQ for background jobs (notifications, audit logs, reminders).
REDIS_URL="redis://localhost:6379"

# Docker Compose Redis host port (default: 6379)
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Application Base URL
# ------------------------------------------------------------------------------
# The canonical public URL where the application is hosted.
# Used for QR code patient registration invitations, email confirmation links,
# and password reset URLs.
# In production, set to your domain (e.g. https://dently.app).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Super Admin Access
# ------------------------------------------------------------------------------
# Comma-separated list of email addresses authorized to access the Super Admin
# Platform portal at /platform/clinics.
SUPER_ADMIN_EMAILS="admin@dently.app"

# ------------------------------------------------------------------------------
# 5. Platform System SMTP Email Configuration
# ------------------------------------------------------------------------------
# Used for system notifications, clinic registration confirmations, and password resets.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@dently.app"
SMTP_FROM_NAME="Dently SaaS Platform"

# ------------------------------------------------------------------------------
# 6. Environment Mode (Optional - default is managed by Next.js / Node.js)
# ------------------------------------------------------------------------------
NODE_ENV="development"
